# Reference https://github.com/github/gitignore/blob/master/Go.gitignore
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# Compiled Object files, Static and Dynamic libs (Shared Objects)
*.o
*.a
*.so

# OS General
Thumbs.db
.DS_Store

# project
*.cert
*.key
*.log
bin/

# Develop tools
.idea/
*.swp
__debug_*
cmd/server/server
cmd/server/__debug_bin
cmd/mock

# 数据库备份（本地产物，不入库）
deploy/sql/*.sql
deploy/sql/*.sql.gz

# 本地存储渠道运行时数据目录（local 渠道上传的文件）
./mock
./server
pkg/lexnorm/.agents/DESIGN.md
e2e_production

# gen_clients.sh (mobile-desktop-service) 的 buf 临时配置残留
proto/.buf-gen-tmp-*.yaml

# EDAI 本地 SQLite 库与运行时数据（不入库）
app/edai/service/data/

# 本地构建缓存（沙箱环境下 GOCACHE 会被指到仓内，曾以 900MB+ 未跟踪目录
# 污染 git status 并差点被误加进提交）
.cache/
