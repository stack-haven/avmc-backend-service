# .env.example · evie/tool 凭据模板（gitignored；真实 .env.local 不入库）
#
# 用法：
#   cp .env.example .env.local
#   vi .env.local   # 填入真实凭据
#   make run-prod   # 自动 source .env.local

# ============================================================
# Redis（qua 共享缓存，存 oauth2_access_token:<token>）
# ============================================================
REDIS_ADDR=172.16.0.112:6379
REDIS_DB=14
REDIS_PASSWORD=__SET_YOUR_REDIS_PASSWORD__

# ============================================================
# 讯飞 ASR
# ============================================================
XUNFEI_APP_ID=__SET_YOUR_XUNFEI_APP_ID__
XUNFEI_API_KEY=__SET_YOUR_XUNFEI_API_KEY__
XUNFEI_API_SECRET=__SET_YOUR_XUNFEI_API_SECRET__

# ============================================================
# 可选（FunASR 走内网时可加）
# ============================================================
# FUNASR_ADDR=http://127.0.0.1:18000
